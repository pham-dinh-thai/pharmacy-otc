POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: absolute path for uploaded product images.
# Defaults to <backend cwd>/uploads/images and is a Docker volume in compose.
# UPLOAD_DIR=/app/uploads/images

# SePay checkout credentials (sepay-pg-node).
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Secret key you set in SePay portal > Payment Gateway > Config > IPN.
# Independent from SEPAY_SECRET_KEY; must match the X-Secret-Key header.
SEPAY_IPN_SECRET_KEY=
# Public URL used only to redirect the customer after checkout.
PAYMENT_RETURN_URL=https://example.com/orders